/* Only font-related rules
When the UI font-size changes it will reload only this. 
*/

QMainWindow, QWidget, QTreeView, QListView, QTableView, QListWidget,
QHeaderView::section, QPushButton, QLabel, QTextEdit, QLineEdit {
    font-size: {FONT_SIZE};
}

#WelcomeButton {
    font-size: {FONT_SIZE_LARGE};
    padding: {BTN_PADDING_LARGE};
}

#PageTitle {
    font-size: {FONT_SIZE_LARGE};
}

#FloatClearButton, #GenericText, #LogOutput, QToolTip {
    font-size: {FONT_SIZE_SMALL};
}

QPushButton {
    padding: {BTN_PADDING};
    min-width: {BTN_MIN_WIDTH};
}

#ConfirmButton {
    padding: {BTN_PADDING};
    min-width: {BTN_MIN_WIDTH};
}

#DescriptorTag {
    font-size: {FONT_SIZE};
}

#SearchOverlay {
    font-size: 42px;
}